+    def _write_cross_amplitudes(self, hf, comp_readers, comp_windows,
+                                comp_labels, metal_label, ncoeff, northo,
+                                log=print):
+        """
+        Cross-component amplitude passes over the same stored blochstates the
+        main overlap pass reads (same PAW S-metric block-sum identity
+        <psi_i | psi_j> = C_i . C_j^H + B_i . B_ortho_j^H, same streaming
+        reads), with the new operand pairings:
+
+          cross/B      (n_metal, n_MO_total) complex128: <m_n | a>, the metal
+                       window bands vs the concatenated molecule-MO set.
+          cross/S_MO   (n_MO_total, n_MO_total) complex128: <a | a'>, the
+                       Gram matrix of the concatenated molecule-MO set
+                       (within-component blocks are ~ identity).
+          cross/S_mm   (n_metal, n_metal) complex128: <m_n | m_n'>, the
+                       metal-window Gram matrix (approved amendment: the
+                       injected metal states are NOT mutually orthonormal in
+                       the full-cell S-metric, so the exact-projector
+                       decomposition needs the true metal Gram).
+          cross/mo_axis_json  JSON list defining the MO-total axis ordering:
+                       molecule components in comp_labels order (metal
+                       excluded), bands ascending within each; each entry
+                       [component_label, band_index_1based] with the
+                       window-local 1-based index that matches grid/{label}
+                       rows and the txt comp_idx convention.
+          cross/diagnostics/  scalars: S_MO_dev_max = max |S_MO - I|,
+                       S_MO_dev_fro = ||S_MO - I||_F, S_mm_dev_max and
+                       S_mm_dev_fro (same measures for the metal Gram), and
+                       min_eig_S_mt = min eigenvalue of the exact
+                       S_mt = S_mm - B S_MO^-1 B^dagger (the
+                       linear-dependence guard; reduces to the original
+                       I - B S_MO^-1 B^dagger form when S_mm = I).
+
+        The MO set spans the same molecule band windows the matcher already
+        uses (band_windows); the metal set spans the same metal bands the
+        matcher already matches (comp_windows[metal_label]). Reading the same
+        stored blochstates files is what guarantees phase-gauge consistency
+        with grid_amp; wavefunctions are never recomputed. Returns the
+        diagnostics dict so run() can echo it at the end of the matcher run.
+        """
+        import json
+
+        mol_labels = [lbl for lbl in comp_labels if lbl != metal_label]
+
+        # Molecule-MO stack over the SAME band windows the matcher matches;
+        # mo_axis records the axis ordering with window-local 1-based indices.
+        mo_stack = []
+        mo_axis = []
+        for label in mol_labels:
+            win = comp_windows[label]
+            if win is None:
+                bands = range(int(comp_readers[label][3]))
+            else:
+                bands = list(win)
+            for local_pos, src in enumerate(bands):
+                mo_stack.append((label, local_pos, int(src)))
+                mo_axis.append([label, local_pos + 1])
+        n_mo = len(mo_stack)
+
+        metal_bands = np.asarray(comp_windows[metal_label])
+        n_metal = int(len(metal_bands))
+
+        # Metal-axis tile size by the same accounting convention as
+        # _plan_overlap_tiling: 2/3 of true available RAM as the budget,
+        # 16*(2*ncoeff + northo) bytes per resident band (operand + its GEMM
+        # conj transient), with the molecule stack resident, the
+        # (n_metal x n_mo) B output and the (n_metal x n_metal) S_mm output
+        # reserved, and TWO metal tiles resident at once (the S_mm pair loop
+        # holds tile i while streaming tiles j > i).
+        try:
+            import psutil
+            avail_bytes = int(psutil.virtual_memory().available)
+        except Exception:
+            avail_bytes = 2 * 1024 ** 3
+        budget = (2.0 / 3.0) * avail_bytes
+        per_band = 16 * (2 * int(ncoeff) + int(northo))
+        b_out_bytes = 16 * n_metal * max(n_mo, 1)
+        s_mm_bytes = 16 * n_metal * n_metal
+        remaining = budget - n_mo * per_band - b_out_bytes - s_mm_bytes
+        metal_tile = int(max(1, min(n_metal, remaining // max(2 * per_band, 1))))
+        log(f"[MATCHER]   cross passes: n_MO_total={n_mo}, n_metal={n_metal}, "
+            f"metal_tile={metal_tile} of {n_metal}")
+
+        # Molecule stack resident once (the molecule band windows keep it
+        # small); read through the same streaming reader machinery.
+        C_mo, B_mo = self._read_stack_tile(comp_readers, mo_stack, 0, n_mo)
+
+        # S_MO: molecule-MO Gram matrix, one stacked GEMM.
+        S_MO = C_mo @ C_mo.conj().T + B_mo @ B_mo.conj().T
+
+        cross = hf.create_group("cross")
+        ds_b = cross.create_dataset(
+            "B", shape=(n_metal, n_mo), dtype="complex128",
+            chunks=(min(metal_tile, n_metal), max(n_mo, 1)),
+            compression="lzf", shuffle=True, fletcher32=True,
+        )
+        cross.create_dataset(
+            "S_MO", data=S_MO, chunks=True,
+            compression="lzf", shuffle=True, fletcher32=True,
+        )
+        cross.create_dataset("mo_axis_json", data=json.dumps(mo_axis))
+
+        # B and S_mm, streamed over metal band tiles. B rows come from the
+        # resident tile vs the molecule stack; S_mm blocks come from the
+        # resident tile vs itself (diagonal) and vs every later tile
+        # (off-diagonal, mirrored via Hermitian symmetry). B is kept in RAM
+        # as well (n_metal x n_mo is small) for the exact-S_mt diagnostic.
+        B_arr = np.empty((n_metal, n_mo), dtype=np.complex128)
+        S_mm = np.empty((n_metal, n_metal), dtype=np.complex128)
+        metal_reader = comp_readers[metal_label][0]
+        for m0 in range(0, n_metal, metal_tile):
+            m1 = min(m0 + metal_tile, n_metal)
+            C_i, B_i = self._read_bloch_bands(metal_reader, metal_bands[m0:m1])
+            B_blk = C_i @ C_mo.conj().T + B_i @ B_mo.conj().T
+            ds_b[m0:m1, :] = B_blk
+            B_arr[m0:m1, :] = B_blk
+            del B_blk
+            S_mm[m0:m1, m0:m1] = C_i @ C_i.conj().T + B_i @ B_i.conj().T
+            for k0 in range(m1, n_metal, metal_tile):
+                k1 = min(k0 + metal_tile, n_metal)
+                C_j, B_j = self._read_bloch_bands(metal_reader,
+                                                  metal_bands[k0:k1])
+                S_blk = C_i @ C_j.conj().T + B_i @ B_j.conj().T
+                S_mm[m0:m1, k0:k1] = S_blk
+                S_mm[k0:k1, m0:m1] = S_blk.conj().T
+                del C_j, B_j, S_blk
+            del C_i, B_i
+        del C_mo, B_mo
+
+        cross.create_dataset(
+            "S_mm", data=S_mm, chunks=True,
+            compression="lzf", shuffle=True, fletcher32=True,
+        )
+
+        # Diagnostics. min_eig_S_mt is the minimum eigenvalue of the EXACT
+        # S_mt = S_mm - B S_MO^-1 B^dagger (approved amendment: the injected
+        # metal states are not mutually orthonormal in the full-cell
+        # S-metric, so the identity-Gram form would understate the guard);
+        # it reduces to the original I - B S_MO^-1 B^dagger when S_mm = I.
+        dev = S_MO - np.eye(n_mo, dtype=np.complex128)
+        s_mo_dev_max = float(np.max(np.abs(dev))) if n_mo else 0.0
+        s_mo_dev_fro = float(np.linalg.norm(dev)) if n_mo else 0.0
+        dev_mm = S_mm - np.eye(n_metal, dtype=np.complex128)
+        s_mm_dev_max = float(np.max(np.abs(dev_mm))) if n_metal else 0.0
+        s_mm_dev_fro = float(np.linalg.norm(dev_mm)) if n_metal else 0.0
+        del dev_mm
+        S_mm_h = 0.5 * (S_mm + S_mm.conj().T)
+        if n_mo:
+            S_MO_h = 0.5 * (S_MO + S_MO.conj().T)
+            S_mt = S_mm_h - B_arr @ np.linalg.solve(S_MO_h, B_arr.conj().T)
+        else:
+            S_mt = S_mm_h
+        S_mt = 0.5 * (S_mt + S_mt.conj().T)
+        min_eig_s_mt = (float(np.min(np.linalg.eigvalsh(S_mt)))
+                        if n_metal else 1.0)
+
+        diag_group = cross.create_group("diagnostics")
+        diag_group.create_dataset("S_MO_dev_max", data=np.float64(s_mo_dev_max))
+        diag_group.create_dataset("S_MO_dev_fro", data=np.float64(s_mo_dev_fro))
+        diag_group.create_dataset("S_mm_dev_max", data=np.float64(s_mm_dev_max))
+        diag_group.create_dataset("S_mm_dev_fro", data=np.float64(s_mm_dev_fro))
+        diag_group.create_dataset("min_eig_S_mt", data=np.float64(min_eig_s_mt))
+
+        return {
+            "S_MO_dev_max": s_mo_dev_max,
+            "S_MO_dev_fro": s_mo_dev_fro,
+            "S_mm_dev_max": s_mm_dev_max,
+            "S_mm_dev_fro": s_mm_dev_fro,
+            "min_eig_S_mt": min_eig_s_mt,
+        }
