+def toggle(sim, label):
+    """The simulator's toggle box of `label` (its position in the toggle list)."""
+    return sim.chk.boxes[[lab for lab, _ in sim._toggle_defs].index(label)]
+
+
+def feenstra_expected(sim, pts, emin, emax, width=0.0):
+    """
+    The I/V a 'Feenstra' display is divided by, computed here without feenstra.py: the total LDOS
+    at the tip positions `pts` on every DOSCAR sample from min(0, emin) to max(0, emax) (the
+    simulator's own GPU call, topo_only, with its Decay and 0-clamp), I(V) the trapezoid integral
+    from the 0 V sample (the synthetic DOSCAR has one) to each sample, I/V with the 0 V sample
+    interpolated from its neighbours, or with width > 0 the exponentially weighted mean of the
+    sm4_Browser's iv_broadened written out as a loop; returned at the samples in [emin, emax].
+    """
+    E = sim.energies
+    span = np.flatnonzero((E >= min(0.0, emin)) & (E <= max(0.0, emax)))
+    ld, _, _ = sim._calculate_ldos_at_points_gpu(np.asarray(pts, dtype=np.float64), E[span[0]], E[span[-1]],
+                                                 use_energy_decay=sim.use_decay, preserve_orbitals=False,
+                                                 topo_only=True, clamp_occupied=sim.t2_clamp)
+    L = np.asarray(ld, dtype=np.float64)
+    Es = E[span]
+    k0 = int(np.flatnonzero(Es == 0.0)[0])
+    I = np.zeros_like(L)
+    for j in range(len(Es)):
+        a, b = sorted((k0, j))
+        seg = np.trapezoid(L[:, a:b + 1], Es[a:b + 1], axis=1)
+        I[:, j] = seg if j >= k0 else -seg
+    nz = Es != 0.0
+    iv = np.zeros_like(I)
+    iv[:, nz] = I[:, nz] / Es[nz]
+    if width > 0:
+        out = np.zeros_like(iv)
+        for i in range(len(Es)):
+            w = np.exp(-np.abs(Es - Es[i]) / width) * nz
+            out[:, i] = (iv * w).sum(axis=1) / w.sum()
+        iv = out
+    else:
+        for p in range(len(iv)):
+            iv[p, ~nz] = np.interp(Es[~nz], Es[nz], iv[p, nz])
+    return iv[:, (Es >= emin) & (Es <= emax)]
+
+
+def marker_points(sim):
+    """The Single Point / Map markers' tip positions: each marker's z the nearest grid point's (wrapped into the cell), as the simulator takes it."""
+    inv_lv = np.linalg.inv(sim.lv)
+    pts = []
+    for x, y in np.asarray(sim.marker_coords, dtype=np.float64):
+        f = np.dot([x, y, 0.0], inv_lv)
+        f[:2] %= 1.0
+        w = np.dot(f, sim.lv)
+        k = int(np.argmin((sim.grid_xy[:, 0] - w[0]) ** 2 + (sim.grid_xy[:, 1] - w[1]) ** 2))
+        pts.append([x, y, float(sim.current_z_map[k])])
+    return np.array(pts)
+
+
+def spectra_match(sim, width, norm=False):
+    """
+    The marker curves of the spectrum panel (level 0) against the cached marker LDOS summed over
+    atoms and orbitals, divided by feenstra_expected's I/V (width None: the LDOS itself), and with
+    norm divided by their Simpson area as 'Norm' does.
+    """
+    from scipy.integrate import simpson
+    lines = {l.get_label(): np.asarray(l.get_ydata(), dtype=np.float64) for l in sim.ax_spec.get_lines()
+             if l.get_label().startswith('marker_')}
+    tot = np.asarray(sim.cached_spec_ldos, dtype=np.float64).sum(axis=(2, 3))
+    if width is not None:
+        tot = tot / feenstra_expected(sim, marker_points(sim), sim.s_emin.val, sim.s_emax.val, width)
+    if norm:
+        tot = tot / (simpson(tot, x=sim.cached_eg, axis=1)[:, None] + 1e-15)
+    return (len(lines) == len(tot)
+            and all(np.allclose(lines[f'marker_{i}'], tot[i], rtol=1e-4, atol=0.0) for i in range(len(tot))))
+
